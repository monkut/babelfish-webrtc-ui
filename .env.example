# Vite reads VITE_* vars at build time and inlines them into the client bundle.
# Copy this file to .env (or .env.local for personal overrides — gitignored)
# and set values appropriate for the target deployment.
#
# Two targets, two recipes:
#   Local dev (SPA on :5173, backend on :8080 — different origins):
#       set all three vars below.
#   TAICHI on-prem build (Caddy serves the SPA and /api on the same origin):
#       set ONLY the credentials; leave VITE_SIGNALING_URL unset so the app
#       derives /api/offer from window.location.origin.

# Backend WebRTC signaling endpoint (full /offer URL). Leave UNSET for
# same-origin deploys (TAICHI); the app then targets the page's own origin.
# Sibling endpoints (/token, /scenarios) are derived by stripping the trailing
# /offer, so this one variable drives every endpoint.
VITE_SIGNALING_URL=http://localhost:8080/offer

# BabelfishClient credentials for the JWT exchange (POST /token). The SPA
# exchanges these for a bearer token before POST /offer. Baked into the build —
# acceptable for an internal LAN tool, where the host serving the SPA is already
# trusted. Provision via the backend's `create_client` command (see backend
# RUNBOOK "Data: scenarios and clients"). The scenario this client is bound to
# is only a fallback — the browser scenario picker overrides it per session.
VITE_CLIENT_ID=babelfish-spa
VITE_CLIENT_SECRET=replace-with-the-secret-printed-by-create_client
