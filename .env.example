# Vite reads VITE_* vars at build time and inlines them into the client bundle.
# Copy this file to .env (or .env.local for personal overrides — gitignored)
# and set values appropriate for the target deployment.

# Backend WebRTC signaling endpoint. Falls back to http://localhost:8080/offer
# (dev backend) when unset.
#
# TAICHI on-prem (issue #18):
#   VITE_SIGNALING_URL=https://192.168.1.25/api/offer
#
# AWS production (issue #17):
#   VITE_SIGNALING_URL=https://api.example.com/offer
VITE_SIGNALING_URL=http://localhost:8080/offer

# Backend base URL used by the OpenAPI-generated client (custom-fetch.ts).
# Same host as VITE_SIGNALING_URL, without the /offer suffix.
VITE_BASE_URL=http://localhost:8080
