{
  "plugins": ["promise", "import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn"
  },
  "rules": {
    "no-console": "warn",
    "eslint/max-depth": ["error", { "max": 10 }],
    "eslint/max-lines-per-function": ["error", { "max": 65 }],
    "eslint/max-nested-callbacks": ["error", { "max": 20 }],
    "typescript/no-explicit-any": "error",
    "import/no-unassigned-import": "off"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "*.min.js",
    ".react-router",
    "tests"
  ]
}
